# Local-only database defaults. The visual preview does not require MongoDB.
# Never commit real credentials. Production requires explicit Atlas values.
MONGODB_URI=mongodb://127.0.0.1:27018/grocery_list?replicaSet=grocery-rs&directConnection=true
MONGODB_DB_NAME=grocery_list
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
