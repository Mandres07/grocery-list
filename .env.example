# Local-only database defaults. Account and inventory workflows require MongoDB.
# Never commit real credentials. See docs/accounts.md for local setup.
# Production uses separate Vercel settings; Atlas maintenance uses .env.atlas.local.
MONGODB_URI=mongodb://127.0.0.1:27018/grocery_list?replicaSet=grocery-rs&directConnection=true
MONGODB_DB_NAME=grocery_list
NEXTAUTH_URL=http://localhost:3001
# Generate a unique secret for this app; never copy Scorecast credentials.
NEXTAUTH_SECRET=
# Create a Lista de Compras-only Sending access key in your existing Resend account.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Lista de Compras <no-reply@updates.finalscore.win>
# Optional: use an actual monitored inbox if you want replies.
RESEND_REPLY_TO_EMAIL=
