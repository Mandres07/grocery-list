# Copy to .env.atlas.local. Never commit or paste actual values into chat.
# These maintenance settings do not change the running local application.
MONGODB_URI=mongodb+srv://REPLACE_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_HOST/?retryWrites=true&w=majority
MONGODB_DB_NAME=grocery_list_preview
# Grant the maintenance user readWrite on this dedicated, empty recovery DB too.
MONGODB_RESTORE_DB_NAME=grocery_list_restore_preview

# Optional: raw app-user passwords, used only by db:verify-access.
# Quote passwords and do not URL-encode these fields.
ATLAS_PREVIEW_PASSWORD=
ATLAS_PRODUCTION_PASSWORD=
