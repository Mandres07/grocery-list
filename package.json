{
  "name": "grocery-list",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "dev:local": "node scripts/start-local-mongo.mjs && npm run dev",
    "build": "next build --webpack",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:check": "vitest run --config vitest.integration.config.mts",
    "tokens": "node scripts/generate-theme.mjs",
    "predev": "npm run tokens",
    "prebuild": "npm run tokens",
    "db:tools": "node --env-file=.env.atlas.local scripts/run-database-tools.mjs",
    "db:prepare": "npm run db:tools -- prepare",
    "db:inspect": "npm run db:tools -- inspect",
    "db:backup": "npm run db:tools -- backup",
    "db:restore-test": "npm run db:tools -- restore-test",
    "db:verify-access": "npm run db:tools -- verify-access"
  },
  "dependencies": {
    "mongoose": "9.12.0",
    "next": "16.4.5",
    "next-auth": "4.24.15",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": "22.x"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
