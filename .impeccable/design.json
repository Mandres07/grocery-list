      "description": "Variante existente de acción primary.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Guardar cambios</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:var(--size-touch,44px);padding:0 16px;border-radius:var(--size-radius-button,8px);font:600 14px/20px var(--font-family-sans,system-ui);cursor:pointer;transition:background-color .15s;border:0;background:var(--brand,#2f5b43);color:var(--surface,#fff);box-shadow:var(--shadow-action);}.ds-button-primary:hover{background:var(--brand-hover,#244833)}.ds-button-primary:focus-visible{outline:var(--size-focus-width,3px) solid var(--brand,#2f5b43);outline-offset:var(--size-focus-offset,3px);}.ds-button-primary:disabled{opacity:.6;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
